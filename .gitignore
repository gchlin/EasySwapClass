# Python cache / local environments
__pycache__/
*.py[cod]
.venv/
venv/

# Local editor / assistant state
.claude/
.vscode/
.idea/

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Private schedule source files (PDFs and raw data)
/source/*
!/source/README.md

# Private tabular data anywhere in the repository
# Exception: sample_data/ is fully anonymised and safe to commit.
*.csv
!/sample_data/*.csv

# Natural science files are private and should not be uploaded at all.
/natural_science/

# v2 layout: per-version outputs, live (nginx), and shared assets all hold
# timetable data and stay local. CSV/HTML/JSON/MD here are never tracked.
/versions/
/live/
/assets/*
!/assets/_html2canvas.min.js

# Workload analysis output contains teacher data — keep local.
/Analysis/

# UI prototype with real names embedded — keep local.
/docs/_help_demo.html

# This script currently contains hard-coded natural science timetable rows.
# Refactor it to read an ignored data file before tracking it publicly.
/scripts/build_schedule.py

# Office temporary files
~$*.docx

# Local scratch / debug outputs
/tmp_*.txt

# Staged analysis outputs (contain real timetable data) — keep local.
/Analysis_113/
/Analysis_114/

# Split scratch scripts used while editing extract_school.py — keep local.
/scripts/extract_school_1.py
/scripts/extract_school_2.py

# Legacy school-wide working folder (real timetable data + name-bearing HTML).
# Superseded by the v2 versions/ + live/ layout; keep local, never track.
/school_wide/

# Local test fixtures for tests/*.test.js — real timetable data, keep local.
/template/data.js
/template/en_name.js
